{
  "name": "camila-martins-engenharia-app",
  "version": "0.10.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "doctor": "expo-doctor",
    "postinstall": "node scripts/apply-security-patches.mjs",
    "security:patch": "node scripts/apply-security-patches.mjs",
    "security:test": "node scripts/test-security-patches.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "check:homologation": "node --env-file-if-exists=.env.local scripts/verify-homologation-env.mjs",
    "check:production": "node --env-file-if-exists=.env.production.local scripts/verify-production-env.mjs",
    "check:production:cloudflare": "node scripts/verify-production-env.mjs",
    "test:rls-ab": "node --env-file-if-exists=.env.ab.local scripts/rls-ab-test.mjs",
    "export:web": "expo export --platform web",
    "verify:web-export": "node scripts/verify-web-export.mjs",
    "build:web:cloudflare": "npm run check:production:cloudflare && expo export --platform web && npm run verify:web-export"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~57.0.0",
    "expo-doctor": "^1.18.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
