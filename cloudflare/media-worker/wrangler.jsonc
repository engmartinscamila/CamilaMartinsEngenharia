{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cme-public-media",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "midia.camilamartinsengenharia.com.br",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://hghtwlopqztfcosfxafd.supabase.co",
    "ALLOWED_ORIGINS": "https://camilamartinsengenharia.com.br,https://www.camilamartinsengenharia.com.br",
    "MAX_UPLOAD_BYTES": "524288000"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "camila-martins-public-media"
    }
  ]
}
